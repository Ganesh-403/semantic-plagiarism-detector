# ==========================================
# Application Environment Variables Template
# Copy this file to .env and replace the
# placeholder values before running locally.
# ==========================================

# ── Application Environment ────────────────────────────────────────────────────
# Set to 'test' for development/testing, omit or set to 'production' for production
# APP_ENV=production

# ── API Documentation Contact ──────────────────────────────────────────────────
# Shown in the generated OpenAPI docs (/docs) as the local IT/support
# contact for this deployment. Both are optional; unset values are simply
# omitted from the contact info rather than showing a placeholder.
# API_SUPPORT_EMAIL=ithelp@youruniversity.edu
# API_SUPPORT_URL=https://it.youruniversity.edu/support

# ── Authentication & JWT Configuration ─────────────────────────────────────────

# JWT secret key for signing tokens. MUST be set in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-generate-new-in-production

# API Bearer Token for REST API authentication.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_BEARER_TOKEN=your-secret-api-bearer-token

# Optional: comma-separated list of additional API bearer tokens in JSON format
# API_BEARER_TOKENS_MAPPING={"token1": ["read"], "token2": ["read", "write", "admin"]}

# ── Single Sign-On (SSO) Configuration ─────────────────────────────────────────

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Application Base URL (Used for OAuth redirect URIs)
APP_BASE_URL=http://localhost:8501

# ── Redis Configuration ────────────────────────────────────────────────────────

# Redis connection URL (overrides individual host/port settings if provided)
REDIS_URL=redis://localhost:6379/0

# Redis server host (fallback if REDIS_URL not set)
REDIS_HOST=localhost

# Redis server port (fallback if REDIS_URL not set)
REDIS_PORT=6379

# Redis database number (fallback if REDIS_URL not set)
REDIS_DB=0

# Redis password (if required)
REDIS_PASSWORD=

# Default Cache Key Expiration TTL in seconds (default: 3600 seconds / 1 hour)
REDIS_CACHE_TTL=3600

# ── Application Settings ───────────────────────────────────────────────────────

# The default similarity score (0.0 to 1.0) above which text is flagged as plagiarism.
PLAGIARISM_THRESHOLD=0.59

# The maximum allowed file size for document uploads in megabytes (MB).
MAX_UPLOAD_SIZE_MB=50

# ── External APIs ──────────────────────────────────────────────────────────────

# API key for the DeepL translation service (required for cross-lingual plagiarism detection).
# Leave blank or comment out if cross-lingual features are not needed.
DEEPL_API_KEY=your_deepl_api_key_here

# ── SMTP Configuration ─────────────────────────────────────────────────────────

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=your-email@gmail.com
ADMIN_EMAIL=admin@example.com

# ── External Webhook Configuration ─────────────────────────────────────────────

PLAGIARISM_WEBHOOK_URL=https://example.com/webhook

# Secret key used for signing/verifying webhook signature payloads via HMAC.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET_KEY=your-secret-key-here

# ── CORS Configuration ─────────────────────────────────────────────────────────

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Synchronization Configuration ──────────────────────────────────────────────

# Timeout (in seconds) when attempting to acquire synchronization locks.
LOCK_TIMEOUT_SECONDS=30

# ── Database Backup Configuration ─────────────────────────────────────────────
# (Additional database backup settings)


# --- AWS S3 Report Export ---
# Optional: export plagiarism reports to an S3 bucket (Issue #3464).
# Also requires the boto3 package: pip install boto3
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_S3_BUCKET=
