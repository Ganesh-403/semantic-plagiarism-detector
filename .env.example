# ==========================================
# Application Environment Variables Template
# Copy this file to .env and replace the
# placeholder values before running locally.
# ==========================================

# Redis
REDIS_URL=redis://localhost:6379/0

# External Webhook
PLAGIARISM_WEBHOOK_URL=https://example.com/webhook

# API Authentication
API_BEARER_TOKEN=your_api_bearer_token_here

 docs/add-env-example-1181
# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
=======
# ── Redis Configuration ────────────────────────────────────────────────────────

# Redis connection URL (overrides individual host/port settings if provided)
REDIS_URL=

# Redis server host (fallback if REDIS_URL not set)
REDIS_HOST=localhost

# Redis server port (fallback if REDIS_URL not set)
REDIS_PORT=6379

# Redis database number (fallback if REDIS_URL not set)
REDIS_DB=0

# Redis password (if required)
REDIS_PASSWORD=

# Default Cache Key Expiration TTL in seconds (default: 3600 seconds / 1 hour)
REDIS_CACHE_TTL=3600

# ── Daily Summary Email Configuration ───────────────────────────────────────────

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=your-email@gmail.com
ADMIN_EMAIL=admin@example.com

# ── LMS REST API Configuration ───────────────────────────────────────────────

API_BEARER_TOKEN=your-secret-lms-bearer-token

# Timeout (in seconds) when attempting to acquire synchronization locks.
LOCK_TIMEOUT_SECONDS=30

# ── Database Backup Configuration ─────────────────────────────────────────────

# Backup idle timeout in minutes. The system will automatically back up the
# database after this duration of system-wide inactivity.
# Default: 30
BACKUP_IDLE_TIMEOUT_MINUTES=30

# ── Embedding Model Configuration ─────────────────────────────────────────────

# Batch size for forward passes during SentenceTransformer vector encoding.
# Tune lower (e.g. 16 or 32) for low-VRAM GPUs/CPUs, or higher (e.g. 64 or 128) for high-memory GPUs.
EMBEDDING_BATCH_SIZE=32
 main
