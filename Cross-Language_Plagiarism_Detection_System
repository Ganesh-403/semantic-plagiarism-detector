# ==================== Language Support ====================

class LanguageSupport:
    """Language detection and translation support"""
    
    SUPPORTED_LANGUAGES = {
        'en': 'English',
        'es': 'Spanish',
        'fr': 'French',
        'de': 'German',
        'it': 'Italian',
        'pt': 'Portuguese',
        'ru': 'Russian',
        'zh-cn': 'Chinese (Simplified)',
        'ja': 'Japanese',
        'ko': 'Korean',
        'ar': 'Arabic',
        'hi': 'Hindi',
        'nl': 'Dutch',
        'pl': 'Polish',
        'tr': 'Turkish',
        'vi': 'Vietnamese',
        'th': 'Thai',
        'id': 'Indonesian',
        'ms': 'Malay',
        'fa': 'Persian'
    }
    
    @staticmethod
    def detect_language(text: str) -> str:
        """Detect language of text using common patterns"""
        # Common language indicators
        indicators = {
            'en': ['the', 'and', 'for', 'with', 'this'],
            'es': ['el', 'la', 'de', 'que', 'y'],
            'fr': ['le', 'la', 'et', 'de', 'pour'],
            'de': ['der', 'die', 'und', 'für', 'mit'],
            'it': ['il', 'la', 'di', 'che', 'per'],
            'pt': ['o', 'a', 'de', 'que', 'para'],
            'ru': ['и', 'в', 'не', 'на', 'с'],
            'zh-cn': ['的', '了', '是', '我', '你'],
            'ja': ['の', 'です', 'ます', 'は', 'が'],
            'ko': ['은', '는', '이', '가', '을']
        }
        
        # Simple detection based on common words
        words = text.lower().split()
        if not words:
            return 'en'
        
        scores = defaultdict(int)
        for lang, indicators_list in indicators.items():
            for indicator in indicators_list:
                if indicator in text.lower():
                    scores[lang] += 1
        
        if scores:
            return max(scores, key=scores.get)
        return 'en'
    
    @staticmethod
    def get_language_name(code: str) -> str:
        """Get full language name from code"""
        return LanguageSupport.SUPPORTED_LANGUAGES.get(code, 'Unknown')
    
    @staticmethod
    def translate_text(text: str, target_lang: str = 'en', 
                       source_lang: str = None) -> str:
        """Translate text using Google Translate API"""
        if not HAS_GOOGLETRANS:
            return text
        
        try:
            translator = Translator()
            if source_lang:
                result = translator.translate(text, dest=target_lang, src=source_lang)
            else:
                result = translator.translate(text, dest=target_lang)
            return result.text
        except Exception as e:
            print(f"Translation error: {e}")
            return text

# ==================== Text Processing ====================

class TextProcessor:
    """Advanced text processing for plagiarism detection"""
    
    @staticmethod
    def preprocess_text(text: str) -> str:
        """Clean and normalize text"""
        # Remove extra whitespace
        text = ' '.join(text.split())
        
        # Remove special characters but keep punctuation
        text = re.sub(r'[^\w\s.,!?;:()"-]', ' ', text)
        
        # Normalize whitespace
        text = re.sub(r'\s+', ' ', text)
        
        return text.strip()
    
    @staticmethod
    def tokenize(text: str) -> List[str]:
        """Tokenize text into words"""
        text = text.lower()
        # Remove punctuation
        text = text.translate(str.maketrans('', '', string.punctuation))
        return text.split()
    
    @staticmethod
    def get_ngrams(text: str, n: int = 3) -> List[str]:
        """Extract n-grams from text"""
        tokens = TextProcessor.tokenize(text)
        ngrams = []
        for i in range(len(tokens) - n + 1):
            ngram = ' '.join(tokens[i:i+n])
            ngrams.append(ngram)
        return ngrams
    
    @staticmethod
    def get_char_ngrams(text: str, n: int = 4) -> List[str]:
        """Extract character n-grams from text"""
        text = text.lower()
        text = re.sub(r'[^a-z0-9]', ' ', text)
        char_ngrams = []
        for i in range(len(text) - n + 1):
            char_ngrams.append(text[i:i+n])
        return char_ngrams
    
    @staticmethod
    def get_fingerprint(text: str) -> str:
        """Generate a unique fingerprint for text"""
        # Clean and normalize
        text = TextProcessor.preprocess_text(text)
        text = text.lower()
        
        # Remove common words (stopwords)
        stopwords = {'the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 
                     'to', 'for', 'of', 'with', 'without'}
        words = text.split()
        filtered = [w for w in words if w not in stopwords]
        
        # Sort words for fingerprint
        sorted_words = sorted(filtered)
        
        # Create hash
        fingerprint = hashlib.md5(' '.join(sorted_words).encode()).hexdigest()
        return fingerprint

# ==================== Core Detection Engine ====================

class CrossLanguageDetector:
    """Main plagiarism detection engine"""
    
    def __init__(self):
        self.text_processor = TextProcessor()
        self.language_support = LanguageSupport()
        self.documents: Dict[str, Document] = {}
        self.cache = {}
        
        # Initialize semantic model if available
        self.semantic_model = None
        if HAS_SENTENCE_TRANSFORMERS:
            try:
                self.semantic_model = SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2')
            except Exception as e:
                print(f"Failed to load semantic model: {e}")
        
        # Initialize TF-IDF if available
        self.tfidf_vectorizer = None
        self.tfidf_matrix = None
        self.tfidf_doc_ids = []
        
    def add_document(self, content: str, language: str = None,
                     title: str = "", author: str = "", 
                     source: str = "", doc_id: str = None) -> str:
        """Add a document to the detection system"""
        if doc_id is None:
            doc_id = f"doc_{hashlib.md5(content[:100].encode()).hexdigest()[:8]}"
        
        # Detect language if not provided
        if language is None:
            language = self.language_support.detect_language(content)
        
        document = Document(
            id=doc_id,
            content=content,
            language=language,
            title=title,
            author=author,
            source=source
        )
        
        self.documents[doc_id] = document
        self.cache[doc_id] = {
            'fingerprint': self.text_processor.get_fingerprint(content),
            'tokens': self.text_processor.tokenize(content),
            'ngrams': self.text_processor.get_ngrams(content),
            'char_ngrams': self.text_processor.get_char_ngrams(content)
        }
        
        return doc_id
    
    def detect_plagiarism(self, doc_id: str, 
                          methods: List[str] = None) -> List[PlagiarismMatch]:
        """Detect plagiarism for a document"""
        if methods is None:
            methods = ['fingerprint', 'ngram', 'semantic', 'translation']
        
        if doc_id not in self.documents:
            raise ValueError(f"Document {doc_id} not found")
        
        target_doc = self.documents[doc_id]
        matches = []
        
        for source_id, source_doc in self.documents.items():
            if source_id == doc_id:
                continue
            
            # Skip if different languages and no translation method
            if source_doc.language != target_doc.language and 'translation' not in methods:
                continue
            
            match = self._compare_documents(source_doc, target_doc, methods)
            if match and match.similarity_score > 0.3:
                matches.append(match)
        
        return sorted(matches, key=lambda x: x.similarity_score, reverse=True)
    
    def _compare_documents(self, source: Document, target: Document,
                          methods: List[str]) -> Optional[PlagiarismMatch]:
        """Compare two documents using specified methods"""
        best_match = None
        best_score = 0
        
        for method in methods:
            score = 0
            matched_source = ""
            matched_target = ""
            confidence = 0
            
            if method == 'fingerprint':
                score, confidence = self._fingerprint_comparison(source, target)
                if score > best_score:
                    matched_source = source.content[:200]
                    matched_target = target.content[:200]
                    
            elif method == 'ngram':
                score, confidence, src_ngrams, tgt_ngrams = self._ngram_comparison(source, target)
                if score > best_score:
                    matched_source = ' '.join(src_ngrams[:5]) if src_ngrams else ""
                    matched_target = ' '.join(tgt_ngrams[:5]) if tgt_ngrams else ""
                    
            elif method == 'semantic' and self.semantic_model:
                score, confidence = self._semantic_comparison(source, target)
                if score > best_score:
                    matched_source = source.content[:200]
                    matched_target = target.content[:200]
                    
            elif method == 'translation':
                score, confidence = self._translation_comparison(source, target)
                if score > best_score:
                    matched_source = source.content[:200]
                    matched_target = target.content[:200]
            
            if score > best_score:
                best_score = score
                best_match = PlagiarismMatch(
                    source_doc_id=source.id,
                    target_doc_id=target.id,
                    similarity_score=score,
                    matched_text_source=matched_source,
                    matched_text_target=matched_target,
                    source_language=source.language,
                    target_language=target.language,
                    method=method,
                    confidence=confidence
                )
        
        return best_match
    
    def _fingerprint_comparison(self, source: Document, target: Document) -> Tuple[float, float]:
        """Compare documents using fingerprint hashing"""
        source_fp = self.cache[source.id]['fingerprint']
        target_fp = self.cache[target.id]['fingerprint']
        
        if source_fp == target_fp:
            return 1.0, 1.0
        
        # Compare sub-fingerprints (50-char chunks)
        chunks_source = self._get_chunks(source.content, 50)
        chunks_target = self._get_chunks(target.content, 50)
        
        common = set(chunks_source) & set(chunks_target)
        if chunks_source:
            similarity = len(common) / len(chunks_source)
        else:
            similarity = 0
        
        confidence = min(1.0, (len(common) / 10))
        return similarity, confidence
    
    def _get_chunks(self, text: str, size: int) -> List[str]:
        """Split text into chunks for fingerprinting"""
        text = self.text_processor.preprocess_text(text)
        words = text.split()
        chunks = []
        for i in range(0, len(words), size):
            chunk = ' '.join(words[i:i+size])
            chunks.append(hashlib.md5(chunk.encode()).hexdigest())
        return chunks
    
    def _ngram_comparison(self, source: Document, target: Document) -> Tuple[float, float, List[str], List[str]]:
        """Compare documents using n-gram analysis"""
        src_ngrams = self.cache[source.id]['ngrams']
        tgt_ngrams = self.cache[target.id]['ngrams']
        
        common = set(src_ngrams) & set(tgt_ngrams)
        if src_ngrams:
            similarity = len(common) / len(src_ngrams)
        else:
            similarity = 0
        
        # Find common n-grams
        common_ngrams = [ng for ng in src_ngrams if ng in common]
        
        confidence = min(1.0, len(common) / 20)
        return similarity, confidence, common_ngrams[:10], common_ngrams[:10]
    
    def _semantic_comparison(self, source: Document, target: Document) -> Tuple[float, float]:
        """Compare documents using semantic similarity"""
        if not self.semantic_model:
            return 0.0, 0.0
        
        try:
            # Encode texts
            source_emb = self.semantic_model.encode(source.content[:512])
            target_emb = self.semantic_model.encode(target.content[:512])
            
            # Calculate cosine similarity
            similarity = np.dot(source_emb, target_emb) / (np.linalg.norm(source_emb) * np.linalg.norm(target_emb))
            
            confidence = min(1.0, similarity * 1.2)
            return float(similarity), float(confidence)
            
        except Exception as e:
            print(f"Semantic comparison error: {e}")
            return 0.0, 0.0
    
    def _translation_comparison(self, source: Document, target: Document) -> Tuple[float, float]:
        """Compare documents after translation"""
        if not HAS_GOOGLETRANS:
            return 0.0, 0.0
        
        try:
            # Translate both to English
            source_translated = self.language_support.translate_text(source.content[:500], 'en')
            target_translated = self.language_support.translate_text(target.content[:500], 'en')
            
            # Simple similarity using n-grams
            source_ngrams = self.text_processor.get_ngrams(source_translated, 2)
            target_ngrams = self.text_processor.get_ngrams(target_translated, 2)
            
            common = set(source_ngrams) & set(target_ngrams)
            if source_ngrams:
                similarity = len(common) / len(source_ngrams)
            else:
                similarity = 0
            
            confidence = min(1.0, similarity * 0.8 + 0.2)
            return similarity, confidence
            
        except Exception as e:
            print(f"Translation comparison error: {e}")
            return 0.0, 0.0
    
    def generate_report(self, doc_id: str, threshold: float = 0.3) -> PlagiarismReport:
        """Generate a comprehensive plagiarism report"""
        matches = self.detect_plagiarism(doc_id)
        filtered_matches = [m for m in matches if m.similarity_score >= threshold]
        
        if not filtered_matches:
            return PlagiarismReport(
                document_id=doc_id,
                total_matches=0,
                similarity_percentage=0,
                matches=[],
                risk_level="Low",
                summary="No significant plagiarism detected.",
                recommendations=["Continue practicing original writing"]
            )
        
        avg_similarity = sum(m.similarity_score for m in filtered_matches) / len(filtered_matches)
        similarity_percentage = avg_similarity * 100
        
        # Determine risk level
        if similarity_percentage >= 70:
            risk_level = "Critical"
        elif similarity_percentage >= 50:
            risk_level = "High"
        elif similarity_percentage >= 30:
            risk_level = "Medium"
        else:
            risk_level = "Low"
        
        # Generate summary
        doc = self.documents[doc_id]
        summary = f"Found {len(filtered_matches)} matches across {len(set(m.source_doc_id for m in filtered_matches))} source documents. "
        summary += f"Average similarity: {similarity_percentage:.1f}%. "
        
        # Recommendations
        recommendations = []
        if risk_level in ["High", "Critical"]:
            recommendations.append("⚠️ Immediate action required: Review and rewrite plagiarized sections")
            recommendations.append("📝 Properly cite all external sources")
            recommendations.append("🔄 Use paraphrasing techniques to express ideas in your own words")
            recommendations.append("📚 Consult original sources to ensure proper understanding")
        elif risk_level == "Medium":
            recommendations.append("📖 Review similarities and ensure proper attribution")
            recommendations.append("🔍 Check for unintentional similarities")
            recommendations.append("💡 Consider reorganizing your content")
        else:
            recommendations.append("✅ Continue current practices")
            recommendations.append("📝 Maintain proper citation habits")
        
        if len(set(m.source_doc_id for m in filtered_matches)) > 1:
            recommendations.append("📊 Consider using more diverse sources")
        
        return PlagiarismReport(
            document_id=doc_id,
            total_matches=len(filtered_matches),
            similarity_percentage=similarity_percentage,
            matches=filtered_matches,
            risk_level=risk_level,
            summary=summary,
            recommendations=recommendations
        )

# ==================== Cross-Language Theft Detection ====================

class CrossLanguageTheftDetector(CrossLanguageDetector):
    """Specialized detector for cross-language content theft"""
    
    def __init__(self):
        super().__init__()
        self.language_pairs: Dict[Tuple[str, str], int] = defaultdict(int)
        self.theft_patterns = []
    
    def detect_content_theft(self, doc_id: str) -> Dict:
        """Detect potential content theft across languages"""
        matches = self.detect_plagiarism(doc_id)
        
        # Analyze language pairs
        for match in matches:
            pair = (match.source_language, match.target_language)
            self.language_pairs[pair] += 1
        
        # Identify theft patterns
        theft_indicators = {
            'translation_theft': 0,
            'paraphrase_theft': 0,
            'direct_copy': 0,
            'structure_theft': 0
        }
        
        for match in matches:
            if match.method == 'translation':
                theft_indicators['translation_theft'] += 1
            elif match.similarity_score > 0.8:
                theft_indicators['direct_copy'] += 1
            elif 0.5 <= match.similarity_score <= 0.8:
                theft_indicators['paraphrase_theft'] += 1
            
            # Check structural similarity
            if self._structural_similarity(match):
                theft_indicators['structure_theft'] += 1
        
        # Generate theft analysis
        doc = self.documents.get(doc_id)
        analysis = {
            'document_id': doc_id,
            'document_title': doc.title if doc else '',
            'language': doc.language if doc else '',
            'total_matches': len(matches),
            'theft_indicators': theft_indicators,
            'high_risk_matches': [m for m in matches if m.similarity_score > 0.7],
            'language_pairs': dict(self.language_pairs),
            'risk_assessment': self._assess_theft_risk(theft_indicators, matches)
        }
        
        return analysis
    
    def _structural_similarity(self, match: PlagiarismMatch) -> bool:
        """Check structural similarity between documents"""
        source = self.documents.get(match.source_doc_id)
        target = self.documents.get(match.target_doc_id)
        
        if not source or not target:
            return False
        
        # Compare paragraph count and sentence structure
        source_paragraphs = source.content.split('\n\n')
        target_paragraphs = target.content.split('\n\n')
        
        if len(source_paragraphs) == 0 or len(target_paragraphs) == 0:
            return False
        
        # Compare paragraph counts
        if abs(len(source_paragraphs) - len(target_paragraphs)) <= 1:
            # Check sentence structure in first few paragraphs
            for i in range(min(3, len(source_paragraphs), len(target_paragraphs))):
                source_sentences = source_paragraphs[i].split('.')
                target_sentences = target_paragraphs[i].split('.')
                if abs(len(source_sentences) - len(target_sentences)) <= 1:
                    return True
        
        return False
    
    def _assess_theft_risk(self, indicators: Dict, matches: List) -> str:
        """Assess the overall theft risk level"""
        high_risk_count = len([m for m in matches if m.similarity_score > 0.7])
        
        score = 0
        score += indicators['translation_theft'] * 3
        score += indicators['direct_copy'] * 5
        score += indicators['paraphrase_theft'] * 2
        score += high_risk_count * 2
        
        if score >= 20:
            return "Critical Theft Risk"
        elif score >= 12:
            return "High Theft Risk"
        elif score >= 6:
            return "Moderate Theft Risk"
        else:
            return "Low Theft Risk"

# ==================== Training Data Generator ====================

class TrainingDataGenerator:
    """Generate training data for plagiarism detection"""
    
    @staticmethod
    def generate_plagiarism_examples(num_examples: int = 100) -> List[Dict]:
        """Generate synthetic plagiarism examples"""
        examples = []
        
        templates = [
            "The rapid advancement of technology has transformed the way we live and work.",
            "Climate change poses one of the most significant challenges of our time.",
            "Education is the foundation of a prosperous and equitable society.",
            "Innovation drives economic growth and social progress.",
            "Healthcare systems around the world face unprecedented challenges."
        ]
        
        languages = ['en', 'es', 'fr', 'de', 'it', 'pt']
        
        for i in range(num_examples):
            # Choose base template
            template = random.choice(templates)
            
            # Generate original and plagiarized versions
            original = template
            plagiarized = template
            
            # Apply plagiarism techniques
            technique = random.choice(['translation', 'paraphrase', 'synonym', 'structure'])
            
            if technique == 'translation':
                # Translate to another language and back
                target_lang = random.choice([l for l in languages if l != 'en'])
                translated = LanguageSupport.translate_text(original, target_lang)
                plagiarized = LanguageSupport.translate_text(translated, 'en')
                
            elif technique == 'paraphrase':
                # Simple paraphrasing: reorder words
                words = original.split()
                if len(words) > 5:
                    middle = len(words) // 2
                    plagiarized = ' '.join(words[:middle] + words[middle+1:] + words[middle:middle+1])
                else:
                    plagiarized = original
                    
            elif technique == 'synonym':
                # Replace words with synonyms (simplified)
                synonyms = {
                    'rapid': ['swift', 'quick', 'fast'],
                    'transformed': ['changed', 'altered', 'modified'],
                    'significant': ['important', 'major', 'crucial'],
                    'foundation': ['basis', 'base', 'core'],
                    'prosperous': ['affluent', 'wealthy', 'thriving']
                }
                for word, syns in synonyms.items():
                    if word in plagiarized and random.random() > 0.5:
                        plagiarized = plagiarized.replace(word, random.choice(syns))
                        
            elif technique == 'structure':
                # Modify structure but keep meaning
                sentences = original.split('.')
                if len(sentences) > 1:
                    random.shuffle(sentences)
                    plagiarized = '. '.join(sentences)
                else:
                    plagiarized = original
            
            examples.append({
                'original': original,
                'plagiarized': plagiarized,
                'technique': technique,
                'language': 'en'
            })
        
        return examples

