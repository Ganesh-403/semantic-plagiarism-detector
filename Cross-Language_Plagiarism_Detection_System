        """Add a new document"""
        print("\n📝 ADD DOCUMENT")
        content = input("Enter document content: ").strip()
        if not content:
            print("❌ Content cannot be empty")
            return
        
        title = input("Title (optional): ").strip()
        author = input("Author (optional): ").strip()
        source = input("Source (optional): ").strip()
        
        # Detect language
        language = LanguageSupport.detect_language(content)
        print(f"📋 Detected language: {LanguageSupport.get_language_name(language)} ({language})")
        
        doc_id = self.detector.add_document(content, language, title, author, source)
        print(f"✅ Document added successfully!")
        print(f"📋 Document ID: {doc_id}")
    
    def _detect_plagiarism(self):
        """Detect plagiarism for a document"""
        print("\n🔍 DETECT PLAGIARISM")
        doc_id = input("Enter Document ID: ").strip()
        
        if doc_id not in self.detector.documents:
            print("❌ Document not found")
            return
        
        doc = self.detector.documents[doc_id]
        print(f"\n📄 Checking: {doc.title or 'Untitled'} ({doc.language})")
        
        matches = self.detector.detect_plagiarism(doc_id)
        matches = [m for m in matches if m.similarity_score > 0.2]
        
        if not matches:
            print("✅ No significant plagiarism detected!")
            return
        
        print(f"\n📊 Found {len(matches)} potential matches:")
        for i, match in enumerate(matches[:5], 1):
            print(f"\n{i}. Source: {match.source_doc_id}")
            print(f"   Similarity: {match.similarity_score:.2%}")
            print(f"   Method: {match.method}")
            print(f"   Confidence: {match.confidence:.2%}")
            print(f"   Languages: {match.source_language} → {match.target_language}")
            
            if match.similarity_score > 0.5:
                print(f"   ⚠️  Matched text: {match.matched_text_source[:100]}...")
    
    def _generate_report(self):
        """Generate a plagiarism report"""
        print("\n📊 GENERATE REPORT")
        doc_id = input("Enter Document ID: ").strip()
        
        if doc_id not in self.detector.documents:
            print("❌ Document not found")
            return
        
        report = self.detector.generate_report(doc_id)
        
        print("\n" + "=" * 60)
        print("PLAGIARISM REPORT".center(60))
        print("=" * 60)
        print(f"\n📄 Document ID: {report.document_id}")
        print(f"📊 Total Matches: {report.total_matches}")
        print(f"📈 Similarity Percentage: {report.similarity_percentage:.1f}%")
        print(f"⚠️  Risk Level: {report.risk_level}")
        print(f"\n📝 Summary: {report.summary}")
        
        print("\n💡 Recommendations:")
        for rec in report.recommendations:
            print(f"  • {rec}")
        
        if report.matches:
            print("\n🔍 Top Matches:")
            for i, match in enumerate(report.matches[:3], 1):
                print(f"\n  {i}. Similarity: {match.similarity_score:.2%}")
                print(f"     Method: {match.method}")
                print(f"     Source ID: {match.source_doc_id}")
        
        # Save report
        save = input("\n💾 Save report to file? (y/n): ").strip().lower() == 'y'
        if save:
            filename = f"report_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
            with open(filename, 'w') as f:
                json.dump({
                    'document_id': report.document_id,
                    'total_matches': report.total_matches,
                    'similarity_percentage': report.similarity_percentage,
                    'risk_level': report.risk_level,
                    'summary': report.summary,
                    'recommendations': report.recommendations,
                    'matches': [m.to_dict() for m in report.matches]
                }, f, indent=2, default=str)
            print(f"✅ Report saved to {filename}")
    
    def _detect_theft(self):
        """Detect cross-language content theft"""
        print("\n🔎 CROSS-LANGUAGE THEFT DETECTION")
        doc_id = input("Enter Document ID: ").strip()
        
        if doc_id not in self.detector.documents:
            print("❌ Document not found")
            return
        
        analysis = self.detector.detect_content_theft(doc_id)
        
        print("\n" + "=" * 60)
        print("CONTENT THEFT ANALYSIS".center(60))
        print("=" * 60)
        
        print(f"\n📄 Document: {analysis['document_title']}")
        print(f"🌐 Language: {analysis['language']}")
        print(f"📊 Total Matches: {analysis['total_matches']}")
        print(f"⚠️  Risk Assessment: {analysis['risk_assessment']}")
        
        print("\n🔍 Theft Indicators:")
        for indicator, count in analysis['theft_indicators'].items():
            if count > 0:
                print(f"  • {indicator.replace('_', ' ').title()}: {count}")
        
        if analysis['high_risk_matches']:
            print(f"\n🚨 High-Risk Matches ({len(analysis['high_risk_matches'])}):")
            for match in analysis['high_risk_matches'][:3]:
                print(f"  • Source: {match.source_doc_id}")
                print(f"    Similarity: {match.similarity_score:.2%}")
                print(f"    Languages: {match.source_language} → {match.target_language}")
    
    def _view_documents(self):
        """View all documents"""
        print("\n📖 DOCUMENTS")
        print("-" * 40)
        
        if not self.detector.documents:
            print("No documents")
            return
        
        for doc_id, doc in self.detector.documents.items():
            print(f"\n🔹 ID: {doc_id}")
            print(f"   Title: {doc.title or 'Untitled'}")
            print(f"   Language: {LanguageSupport.get_language_name(doc.language)}")
            print(f"   Author: {doc.author or 'Unknown'}")
            print(f"   Content length: {len(doc.content)} chars")
            print(f"   Added: {doc.timestamp.strftime('%Y-%m-%d %H:%M')}")
    
    def _compare_documents(self):
        """Compare two documents directly"""
        print("\n🎯 COMPARE DOCUMENTS")
        doc1_id = input("Enter first Document ID: ").strip()
        doc2_id = input("Enter second Document ID: ").strip()
        
        if doc1_id not in self.detector.documents or doc2_id not in self.detector.documents:
            print("❌ One or both documents not found")
            return
        
        doc1 = self.detector.documents[doc1_id]
        doc2 = self.detector.documents[doc2_id]
        
        # Compare using multiple methods
        methods = ['fingerprint', 'ngram', 'semantic', 'translation']
        results = []
        
        for method in methods:
            if method == 'semantic' and not self.detector.semantic_model:
                continue
            if method == 'translation' and not HAS_GOOGLETRANS:
                continue
            
            match = self.detector._compare_documents(doc1, doc2, [method])
            if match:
                results.append((method, match.similarity_score, match.confidence))
        
        print("\n📊 COMPARISON RESULTS")
        print("-" * 40)
        print(f"Document 1: {doc1.title or 'Untitled'} ({doc1.language})")
        print(f"Document 2: {doc2.title or 'Untitled'} ({doc2.language})")
        
        for method, score, confidence in results:
            print(f"\n🔹 Method: {method.title()}")
            print(f"   Similarity: {score:.2%}")
            print(f"   Confidence: {confidence:.2%}")
        
        if results:
            avg_score = sum(s for _, s, _ in results) / len(results)
            print(f"\n📈 Average Similarity: {avg_score:.2%}")
            
            if avg_score > 0.5:
                print("⚠️  High similarity detected! Possible plagiarism.")
            elif avg_score > 0.3:
                print("📝 Moderate similarity detected. Further review recommended.")
            else:
                print("✅ Low similarity detected. Content appears original.")
    
